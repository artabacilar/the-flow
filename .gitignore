node_modules/
life-os-data.json
.env

# Generated seeds — the generators are committed, their output is not.
tests/fixtures/.*.json

# Local build output, and the base it is built from — the base is simply the
# previous life-dashboard.html, which git already has.
src/out/
src/base/

# The app icons are drawn by ios-app/scripts/make-icons.js, which needs
# nothing but Node. Generated output does not belong in the history.
ios-app/native/Assets/

# Screenshots the theme check writes; useful locally, noise in the repo.
.theme-shots/

# The Mac build: its output, and the provisioning profile (downloaded per
# account from the developer site, and nothing anyone else should have).
mac-app/build/
mac-app/*.provisionprofile
# The 1024 preview is regenerated on demand. AppIcon.icns itself IS committed,
# unlike the iOS icons above, and on purpose: the Mac build has to work with
# nothing but the Command Line Tools, and Node is not one of them.
mac-app/Resources/AppIcon-1024.png
